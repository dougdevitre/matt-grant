# ---- Database (AWS DynamoDB, single table) ----
# Table name; credentials come from the default AWS chain (IAM role on Amplify/
# Lambda, or AWS_ACCESS_KEY_ID/SECRET / profile locally).
DYNAMODB_TABLE="matt-grant"
AWS_REGION="us-east-1"

# ---- S3 object assets (logo, brand images, studio output, staff uploads) ----
S3_ASSETS_BUCKET="matt-grant-for-congress"
# CloudFront base URL for public assets (no trailing slash). Leave blank to disable public URLs.
ASSETS_CDN_URL="https://dxxxxxxxx.cloudfront.net"

# ---- Clerk (staff auth for /dashboard) ----
# Get keys from https://dashboard.clerk.com → API Keys.
# If these are absent the app still builds and runs; the dashboard shows a setup notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Staff allowlist backstop: comma-separated emails allowed into the dashboard +
# staff APIs (even if Clerk sign-ups are open). Blank = inactive (Clerk auth only).
DASHBOARD_ALLOWLIST=""

# ---- Press / media ----
# AI interview-topic generator. If absent, /api/press/topics serves a curated,
# platform-faithful topic set instead (the page still works).
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-haiku-4-5-20251001).
ANTHROPIC_MODEL=""
# Scheduling link for reporters (Calendly/Cal.com/Zoom). PLACEHOLDER — leave blank
# to use the in-app /press/schedule page (email fallback) until a real one exists.
NEXT_PUBLIC_MEDIA_BOOKING_URL=""

# ---- Email sending (AWS SES) ----
# Verified sender. Blank = the app saves leads but sends no email (graceful).
# Use a verified DOMAIN sender for deliverability, e.g. "Matt Grant for Congress <info@mattgrantforcongress.org>".
SES_FROM=""
SES_CONFIG_SET=""                 # optional: SES configuration set for bounce/complaint tracking

# ---- SMS (Twilio A2P 10DLC, opt-in only) ----
# From the approved Messaging Service (Twilio Console → Messaging → Services).
# All three blank = the app builds and runs but every send is a graceful no-op
# (like SES). In production these are read from SSM /matt-grant/* at runtime.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""        # the MG... SID (not a bare phone number)
# Inbound keyword that opts a texter in (case-insensitive). Default: MATT.
SMS_OPTIN_KEYWORD="MATT"

# ---- Walgreens Native Photo Prints (print at local Walgreens) ----
# Sandbox creds from https://developer.walgreens.com. Absent = /print shows a
# "coming soon" notice and download fallback (no online ordering).
WALGREENS_API_KEY=""
WALGREENS_AFF_ID=""
WALGREENS_PUBLISHER_ID=""
WALGREENS_ENV="sandbox"            # "sandbox" | "production" (production needs Walgreens approval)

# ---- Opposition research ingestion (Congress.gov + House Clerk) ----
# Free key: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=""
# Secures /api/research/ingest. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
# Target member (default = Ann Wagner, MO-02). Verify via /member?currentMember=true&stateCode=MO.
RESEARCH_BIOGUIDE_ID="W000812"
RESEARCH_VOTE_YEAR="2025"
RESEARCH_FROM_ROLL="1"
RESEARCH_TO_ROLL="60"

# ---- Social Command Center (/dashboard/social) ----
# Every channel degrades to manual mode when its credentials are absent, so all of
# this is optional. Two ways to wire a channel (see web/docs/social-command-center.md):
#
# 1) In-app OAuth connect (recommended) — load each platform's OAuth *app* creds into
#    SSM Parameter Store under /mattgrant/prod/social/<platform>/<field> (client_id /
#    client_secret / redirect_uri; Meta uses app_id / app_secret; TikTok uses
#    client_key). Connectable platforms: facebook (also powers instagram), x, linkedin,
#    tiktok, youtube. For local dev these can be overridden via env:
#    SOCIAL_<PLATFORM>_<FIELD>, e.g. SOCIAL_X_CLIENT_ID, SOCIAL_TIKTOK_CLIENT_KEY.
#
# 2) Manual token fallback (testing / no OAuth app) — flat-name secrets:
X_ACCESS_TOKEN=""
FACEBOOK_PAGE_TOKEN=""
FACEBOOK_PAGE_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""           # e.g. urn:li:organization:123 or urn:li:person:abc
THREADS_ACCESS_TOKEN=""          # Threads is manual-token only (no in-app OAuth yet)
THREADS_USER_ID=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_PRIVACY_LEVEL=""          # default SELF_ONLY until the app passes TikTok audit
YOUTUBE_ACCESS_TOKEN=""
YOUTUBE_PRIVACY_STATUS=""        # default "private" until Google verifies youtube.upload
