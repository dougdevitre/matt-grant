# ---- Database (Vercel Postgres / Neon / Supabase) ----
# Prisma uses this connection string. Pooled URL for runtime; direct for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/matt_grant?sslmode=require"

# ---- Clerk (staff auth for /dashboard) ----
# Get keys from https://dashboard.clerk.com → API Keys.
# If these are absent the app still builds and runs; the dashboard shows a setup notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
