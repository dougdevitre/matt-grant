// Matt Grant for Congress — campaign manager data model.
// Donor PII lives here; handle securely (see SECURITY.md / skill guardrails).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Donor {
  id            String         @id @default(cuid())
  name          String
  email         String?
  phone         String?
  city          String?
  state         String?        @default("MO")
  zip           String?
  // FEC itemization requires employer + occupation for individuals.
  employer      String?
  occupation    String?
  notes         String?
  contributions Contribution[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
}

enum ElectionCycle {
  PRIMARY
  GENERAL
}

model Contribution {
  id          String        @id @default(cuid())
  donor       Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  donorId     String
  amountCents Int
  receivedAt  DateTime      @default(now())
  method      String        @default("WinRed") // WinRed, check, ActBlue, cash, in-kind
  election    ElectionCycle @default(PRIMARY)
  createdAt   DateTime      @default(now())

  @@index([donorId])
}

model Expenditure {
  id          String   @id @default(cuid())
  payee       String
  amountCents Int
  category    String   @default("Operations") // Media, Field, Fundraising, Compliance, Operations, Travel
  memo        String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([category])
}

enum VolunteerStatus {
  NEW
  ACTIVE
  INACTIVE
}

model Volunteer {
  id        String          @id @default(cuid())
  name      String
  email     String?
  phone     String?
  city      String?
  interests String? // canvass, phones, data, events, signs, donate
  status    VolunteerStatus @default(NEW)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id        String       @id @default(cuid())
  title     String
  detail    String?
  category  String       @default("Field") // Field, Finance, Comms, Compliance, Ops
  status    TaskStatus   @default(TODO)
  priority  TaskPriority @default(MEDIUM)
  dueDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

// ---- Opposition research: opponent's public legislative record ----
// All data is federal public record (Congress.gov API + House Clerk roll XML).
// Idempotent: stable unique keys so re-ingestion upserts, never duplicates.

model Legislator {
  bioguideId String      @id
  name       String
  party      String?
  state      String?
  district   String?
  profile    Json?
  source     String      @default("congress.gov")
  updatedAt  DateTime    @updatedAt
  votes      LegVote[]
  bills      LegBill[]
}

model LegVote {
  id         String      @id @default(cuid())
  legislator Legislator  @relation(fields: [bioguideId], references: [bioguideId], onDelete: Cascade)
  bioguideId String
  year       Int
  rollNumber Int
  position   String? // Yea / Nay / Present / Not Voting
  question   String?
  result     String?
  legisNum   String?
  voteDate   DateTime?
  sourceUrl  String
  source     String      @default("clerk.house.gov")

  @@unique([bioguideId, year, rollNumber])
  @@index([bioguideId, year])
}

model LegBill {
  id             String     @id @default(cuid())
  legislator     Legislator @relation(fields: [bioguideId], references: [bioguideId], onDelete: Cascade)
  bioguideId     String
  relation       String // sponsored | cosponsored
  congress       Int
  billType       String
  number         String
  title          String?
  policyArea     String?
  introducedDate DateTime?
  sourceUrl      String
  source         String     @default("congress.gov")

  @@unique([bioguideId, relation, congress, billType, number])
  @@index([bioguideId, relation])
}

model IngestRun {
  id         String   @id @default(cuid())
  target     String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean  @default(false)
  counts     Json?
  error      String?
}

// Phases of the strategic plan, surfaced on the dashboard timeline.
model Milestone {
  id        String   @id @default(cuid())
  phase     String // Build, Fund, Persuade, GOTV
  title     String
  target    DateTime
  done      Boolean  @default(false)
  detail    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([target])
}
